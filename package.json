{
  "name": "awesome-cordova",
  "version": "1.0.0",
  "description": "A curated list of amazingly awesome Cordova libraries, resources and shiny things.",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test scripts/validate-list.test.js && npm run test:links",
    "test:links": "markdown-link-check --config .markdown-link-check.json README.md",
    "test:list": "node scripts/validate-list.js README.md",
    "lint": "markdownlint README.md",
    "validate": "npm run lint && npm test"
  },
  "devDependencies": {
    "markdown-link-check": "^3.12.2",
    "markdownlint-cli": "^0.41.0"
  }
}